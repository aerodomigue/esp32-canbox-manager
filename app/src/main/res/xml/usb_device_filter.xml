<resources>
    <!-- ESP32 CDC ACM (USB Serial) -->
    <!-- Standard CDC ACM class -->
    <usb-device class="2" subclass="2" protocol="1" />

    <!-- ESP32-S2/S3 native USB CDC -->
    <usb-device vendor-id="0x303A" />

    <!-- Espressif USB-JTAG-Serial -->
